<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>AutoRezzer</AssemblyName>
        <RootNamespace>AutoRezzer</RootNamespace>
        <Version>1.4.1.0</Version>
        <FileVersion>1.4.1.0</FileVersion>
        <AssemblyVersion>1.4.1.0</AssemblyVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Platforms>x64</Platforms>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DalamudPackager" Version="11.0.0" />
        <Reference Include="Dalamud">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\Dalamud.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="FFXIVClientStructs">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\FFXIVClientStructs.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="InteropGenerator.Runtime">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\InteropGenerator.Runtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Lumina">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\Lumina.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Lumina.Excel">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\Lumina.Excel.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Dalamud.Bindings.ImGui">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\Dalamud.Bindings.ImGui.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(appdata)\XIVLauncher\addon\Hooks\dev\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <!--
          THE TYPEFACE, COMPILED IN.
          
          Embedded rather than copied beside the DLL: a font next to the assembly is a font that goes
          missing when somebody moves the folder, and the window would silently fall back to
          Dalamud's. Inter, SIL Open Font License, licence file shipped with it.

          The resource names these produce are AutoRezzer.fonts.<file>, which is what UI/Fonts.cs
          asks for. Renaming the folder renames the resource.
        -->
        <EmbeddedResource Include="fonts\Inter-Regular.ttf" />
        <EmbeddedResource Include="fonts\Inter-SemiBold.ttf" />
        <EmbeddedResource Include="fonts\Inter-Bold.ttf" />

        <!-- The window draws its own title bar, so the icon travels inside the DLL:
             the packager does not put images/ into the release zip. -->
        <EmbeddedResource Include="images\icon.png" />
    </ItemGroup>

    <ItemGroup>
        <!--
          The installer icon, copied next to the DLL as well as living in the repo.

          Dalamud resolves the two cases differently: a repo-installed plugin takes its icon from
          the manifest's IconUrl, but a dev plugin has no manifest on any server and so looks for a
          real file at images/icon.png beside the assembly. Without this the dev build - the one
          actually being tested - is the only place the icon is wrong.
        -->
        <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
